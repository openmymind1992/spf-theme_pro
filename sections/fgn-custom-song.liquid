{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = product
  endif
-%}
<style>
  .fgn{--fgn-bg:#fbf6f1;--fgn-ink:#2b1d24;--fgn-muted:#6e5d64;--fgn-accent:#9b2c4f;--fgn-accent-2:#c9a46a;--fgn-card:#fff;--fgn-line:#ead9cf;background:var(--fgn-bg);color:var(--fgn-ink);font-size:16px;line-height:1.6}
  .fgn *{box-sizing:border-box}
  .fgn-wrap{max-width:1120px;margin:0 auto;padding:0 16px}
  .fgn h1,.fgn h2,.fgn h3{font-family:Georgia,'Times New Roman',serif;color:var(--fgn-ink);line-height:1.2;margin:0 0 12px}
  .fgn h1{font-size:clamp(30px,5vw,48px)}
  .fgn h2{font-size:clamp(24px,3.6vw,36px);text-align:center}
  .fgn-eyebrow{display:inline-block;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--fgn-accent);font-weight:700;margin-bottom:10px}
  .fgn-hero{padding:48px 0 40px}
  .fgn-hero-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:40px;align-items:start}
  .fgn-lead{font-size:18px;color:var(--fgn-muted);margin:0 0 20px}
  .fgn-badges{display:flex;flex-wrap:wrap;gap:8px 16px;margin:16px 0 0;padding:0;list-style:none;font-size:14px;color:var(--fgn-muted)}
  .fgn-badges li:before{content:"✓ ";color:var(--fgn-accent);font-weight:700}
  .fgn-media{border-radius:18px;overflow:hidden;background:#efe3da;aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;color:var(--fgn-muted);text-align:center}
  .fgn-media img{width:100%;height:100%;object-fit:cover;display:block}
  .fgn-player{margin-top:16px;background:var(--fgn-card);border:1px solid var(--fgn-line);border-radius:14px;padding:14px 16px}
  .fgn-player p{margin:0 0 8px;font-weight:600;font-size:14px}
  .fgn-player audio{width:100%}
  .fgn-card{background:var(--fgn-card);border:1px solid var(--fgn-line);border-radius:18px;padding:24px;box-shadow:0 10px 30px rgba(43,29,36,.06)}
  .fgn-price{font-size:28px;font-weight:700;color:var(--fgn-accent);margin:4px 0 16px}
  .fgn-pkgs{display:grid;gap:10px;margin:0 0 20px;border:0;padding:0}
  .fgn-pkgs legend,.fgn-label{font-weight:700;font-size:15px;margin-bottom:8px;display:block}
  .fgn-pkg{position:relative;display:flex;justify-content:space-between;gap:12px;align-items:center;border:2px solid var(--fgn-line);border-radius:12px;padding:12px 14px;cursor:pointer;background:#fff}
  .fgn-pkg input{position:absolute;opacity:0;pointer-events:none}
  .fgn-pkg:has(input:checked){border-color:var(--fgn-accent);background:#fdf3f6}
  .fgn-pkg span{font-size:15px}
  .fgn-pkg strong{white-space:nowrap}
  .fgn-field{margin:0 0 14px}
  .fgn-field input[type=text],.fgn-field select,.fgn-field textarea{width:100%;border:1px solid #d9c6bb;border-radius:10px;padding:11px 12px;font:inherit;background:#fff;color:var(--fgn-ink)}
  .fgn-field textarea{min-height:120px;resize:vertical}
  .fgn-hint{font-size:13px;color:var(--fgn-muted);margin-top:4px}
  .fgn-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .fgn-terms{display:flex;gap:10px;align-items:flex-start;font-size:14px;margin:6px 0 16px}
  .fgn-terms input{margin-top:4px;width:18px;height:18px;flex:none}
  .fgn-terms a{color:var(--fgn-accent)}
  .fgn-btn{display:block;width:100%;border:0;border-radius:999px;background:var(--fgn-accent);color:#fff;font-weight:700;font-size:17px;padding:16px 20px;cursor:pointer;text-align:center;text-decoration:none;transition:transform .15s,filter .15s}
  .fgn-btn:hover{filter:brightness(1.08);transform:translateY(-1px)}
  .fgn-btn:disabled{opacity:.6;cursor:not-allowed}
  .fgn-small{font-size:13px;color:var(--fgn-muted);text-align:center;margin-top:10px}
  .fgn-sec{padding:56px 0}
  .fgn-sec.alt{background:#fff}
  .fgn-steps,.fgn-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px}
  .fgn-step{background:var(--fgn-card);border:1px solid var(--fgn-line);border-radius:16px;padding:22px}
  .fgn-step b{display:inline-flex;width:34px;height:34px;border-radius:50%;background:var(--fgn-accent);color:#fff;align-items:center;justify-content:center;margin-bottom:10px}
  .fgn-step h3{font-size:20px}
  .fgn-step p{margin:0;color:var(--fgn-muted)}
  .fgn-occ{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:22px;padding:0;list-style:none}
  .fgn-occ li{border:1px solid var(--fgn-line);background:#fff;border-radius:999px;padding:8px 16px;font-size:15px}
  .fgn-table{width:100%;border-collapse:collapse;margin-top:24px;background:#fff;border-radius:14px;overflow:hidden}
  .fgn-table th,.fgn-table td{padding:12px 14px;border-bottom:1px solid var(--fgn-line);text-align:center;font-size:15px}
  .fgn-table th:first-child,.fgn-table td:first-child{text-align:left}
  .fgn-table thead th{background:#f6ece6}
  .fgn-guarantee{max-width:760px;margin:0 auto;text-align:center}
  .fgn-faq{max-width:780px;margin:24px auto 0}
  .fgn-faq details{background:#fff;border:1px solid var(--fgn-line);border-radius:12px;padding:14px 18px;margin-bottom:10px}
  .fgn-faq summary{cursor:pointer;font-weight:700;list-style:none}
  .fgn-faq summary::-webkit-details-marker{display:none}
  .fgn-faq summary:after{content:"+";float:right;color:var(--fgn-accent)}
  .fgn-faq details[open] summary:after{content:"–"}
  .fgn-faq p{margin:10px 0 0;color:var(--fgn-muted)}
  .fgn-sticky{position:fixed;left:0;right:0;bottom:0;padding:10px 16px;background:rgba(251,246,241,.96);border-top:1px solid var(--fgn-line);z-index:20;display:none}
  .fgn-review-note{text-align:center;color:var(--fgn-muted);font-size:14px}
  .fgn-reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:24px}
  .fgn-review{background:#fff;border:1px solid var(--fgn-line);border-radius:14px;padding:18px}
  .fgn-review .stars{color:var(--fgn-accent-2)}
  @media (max-width:860px){
    .fgn-hero-grid,.fgn-steps,.fgn-grid3,.fgn-reviews{grid-template-columns:1fr}
    .fgn-row{grid-template-columns:1fr}
    .fgn-media{aspect-ratio:16/11}
    .fgn-sticky{display:block}
    .fgn{padding-bottom:70px}
  }
</style>

<div class="fgn">
  <section class="fgn-hero">
    <div class="fgn-wrap fgn-hero-grid">
      <div>
        <span class="fgn-eyebrow">{{ section.settings.eyebrow }}</span>
        <h1>{{ section.settings.heading }}</h1>
        <p class="fgn-lead">{{ section.settings.subheading }}</p>
        <div class="fgn-media">
          {%- if section.settings.hero_image != blank -%}
            {{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: section.settings.heading }}
          {%- else -%}
            <p>Add a hero image or a reaction-video still<br>in the theme editor</p>
          {%- endif -%}
        </div>
        {%- if section.settings.sample_audio_url != blank -%}
          <div class="fgn-player">
            <p>▶ {{ section.settings.sample_title }}</p>
            <audio controls preload="none" src="{{ section.settings.sample_audio_url }}"></audio>
          </div>
        {%- endif -%}
        <ul class="fgn-badges">
          <li>Made from your story</li>
          <li>Private download link</li>
          <li>Free revisions included</li>
        </ul>
      </div>

      <div class="fgn-card" id="fgn-order">
        {%- if p != blank -%}
          <h2 style="text-align:left;font-size:24px">Create their song</h2>
          <div class="fgn-price" data-fgn-price>{{ p.selected_or_first_available_variant.price | money }}</div>
          {%- form 'product', p, id: 'fgn-form' -%}
            <fieldset class="fgn-pkgs">
              <legend>1. Choose your package</legend>
              {%- for v in p.variants -%}
                <label class="fgn-pkg">
                  <input type="radio" name="id" value="{{ v.id }}" data-price="{{ v.price | money }}" {% if v == p.selected_or_first_available_variant %}checked{% endif %} {% unless v.available %}disabled{% endunless %}>
                  <span>{{ v.title }}</span>
                  <strong>{{ v.price | money }}</strong>
                </label>
              {%- endfor -%}
            </fieldset>

            <span class="fgn-label">2. Tell us about them</span>
            <div class="fgn-row">
              <div class="fgn-field">
                <input type="text" name="properties[Recipient name]" placeholder="Their name *" required maxlength="60" aria-label="Recipient name">
              </div>
              <div class="fgn-field">
                <select name="properties[Relationship]" required aria-label="Relationship">
                  <option value="">They are my… *</option>
                  <option>Wife</option><option>Husband</option><option>Girlfriend</option><option>Boyfriend</option>
                  <option>Mom</option><option>Dad</option><option>Daughter</option><option>Son</option>
                  <option>Grandma</option><option>Grandpa</option><option>Granddaughter</option><option>Grandson</option>
                  <option>Best friend</option><option>Other</option>
                </select>
              </div>
            </div>
            <div class="fgn-row">
              <div class="fgn-field">
                <select name="properties[Occasion]" required aria-label="Occasion">
                  <option value="">Occasion *</option>
                  <option>Christmas</option><option>Birthday</option><option>Anniversary</option><option>Wedding</option>
                  <option>Valentine's Day</option><option>Mother's Day</option><option>Father's Day</option>
                  <option>Graduation</option><option>Memorial / In loving memory</option><option>Just because</option>
                </select>
              </div>
              <div class="fgn-field">
                <select name="properties[Music style]" required aria-label="Music style">
                  <option value="">Music style *</option>
                  <option>Acoustic / Folk</option><option>Pop</option><option>Country</option><option>R&amp;B / Soul</option>
                  <option>Rock</option><option>Piano ballad</option><option>Gospel / Christian</option><option>Jazz</option>
                </select>
              </div>
            </div>
            <div class="fgn-field">
              <select name="properties[Voice]" aria-label="Voice">
                <option>Female voice</option><option>Male voice</option><option>No preference</option>
              </select>
            </div>
            <div class="fgn-field">
              <textarea name="properties[Your story]" required minlength="40" placeholder="Share names, nicknames, how you met, favorite memories, inside jokes, what you want them to feel… *" aria-label="Your story"></textarea>
              <div class="fgn-hint">The more details you share, the more personal the lyrics. Min. 40 characters.</div>
            </div>
            <div class="fgn-field">
              <input type="text" name="properties[Must-include words]" placeholder="Words or phrases that must be in the song (optional)" maxlength="200" aria-label="Must-include words">
            </div>

            <label class="fgn-terms">
              <input type="checkbox" name="properties[_Agreed to terms]" value="Yes" required>
              <span>I understand this is a made-to-order digital song created with AI music tools from my story, delivered by email within my package's delivery time, and I agree to the <a href="{{ section.settings.terms_url | default: '/policies/terms-of-service' }}" target="_blank">Terms</a> and <a href="/policies/refund-policy" target="_blank">Refund Policy</a>.</span>
            </label>

            <button type="submit" name="add" class="fgn-btn">{{ section.settings.button_label }}</button>
            <p class="fgn-small">Secure checkout · Digital delivery · No shipping</p>
          {%- endform -%}
        {%- else -%}
          <p>Select the Custom Song product in the theme editor.</p>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="fgn-sec alt">
    <div class="fgn-wrap">
      <h2>How it works</h2>
      <div class="fgn-steps">
        <div class="fgn-step"><b>1</b><h3>Share your story</h3><p>Names, memories and the feeling you want. It takes about 3 minutes.</p></div>
        <div class="fgn-step"><b>2</b><h3>We create the song</h3><p>Original lyrics and a fully produced track with vocals, built around your details and checked by our team.</p></div>
        <div class="fgn-step"><b>3</b><h3>Give the gift</h3><p>Receive a private download link by email. Play it for them and watch the moment happen.</p></div>
      </div>
    </div>
  </section>

  <section class="fgn-sec">
    <div class="fgn-wrap">
      <h2>A song for every person you love</h2>
      <ul class="fgn-occ">
        <li>💍 Wife &amp; husband</li><li>❤️ Girlfriend &amp; boyfriend</li><li>👩 Mom</li><li>👨 Dad</li>
        <li>👧 Daughter &amp; son</li><li>👵 Grandparents</li><li>🎄 Christmas</li><li>🎂 Birthdays</li>
        <li>🥂 Anniversaries</li><li>🕊️ In loving memory</li><li>🤝 Best friends</li>
      </ul>
    </div>
  </section>

  <section class="fgn-sec alt">
    <div class="fgn-wrap">
      <h2>Choose your package</h2>
      <table class="fgn-table">
        <thead><tr><th></th><th>Basic</th><th>Premium</th><th>Rush</th></tr></thead>
        <tbody>
          <tr><td>Price</td><td>$49</td><td>$89</td><td>$129</td></tr>
          <tr><td>Song length</td><td>~2 min</td><td>~3 min</td><td>~3 min</td></tr>
          <tr><td>Files</td><td>MP3 + lyrics</td><td>MP3 + WAV + lyrics PDF</td><td>MP3 + WAV + lyrics PDF</td></tr>
          <tr><td>Free revisions</td><td>1</td><td>2</td><td>2</td></tr>
          <tr><td>Delivered within</td><td>7 days</td><td>5 days</td><td>48 hours</td></tr>
        </tbody>
      </table>
      <p style="text-align:center;margin-top:22px"><a href="#fgn-order" class="fgn-btn" style="display:inline-block;width:auto;padding:14px 34px">Start their song</a></p>
    </div>
  </section>

  {%- if section.blocks.size > 0 -%}
    <section class="fgn-sec">
      <div class="fgn-wrap">
        <h2>What customers say</h2>
        <div class="fgn-reviews">
          {%- for block in section.blocks -%}
            <div class="fgn-review" {{ block.shopify_attributes }}>
              <div class="stars">★★★★★</div>
              <p>“{{ block.settings.quote }}”</p>
              <strong>{{ block.settings.author }}</strong>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  <section class="fgn-sec alt">
    <div class="fgn-wrap fgn-guarantee">
      <h2>Our promise</h2>
      <p>If the lyrics miss a detail you gave us or something doesn't feel right, tell us. Your package includes free revisions based on your original brief, and we'll work with you until it reflects your story. Need to cancel? You can get a full refund any time before production begins.</p>
    </div>
  </section>

  <section class="fgn-sec">
    <div class="fgn-wrap">
      <h2>Questions</h2>
      <div class="fgn-faq">
        <details><summary>How is the song made?</summary><p>We write the song from your story and produce it with modern AI music tools, then our team reviews the lyrics and audio before delivery so names and details are right.</p></details>
        <details><summary>When will I receive it?</summary><p>Within the delivery time of your package: 7 days (Basic), 5 days (Premium) or 48 hours (Rush). You'll get a private download link by email.</p></details>
        <details><summary>Is anything shipped?</summary><p>No. This is a digital product. You receive audio files you can play on any phone or computer and share with family.</p></details>
        <details><summary>What if I want changes?</summary><p>Reply to your delivery email with what to adjust. Revisions cover lyrics, style and voice based on your original brief. A completely new story counts as a new song.</p></details>
        <details><summary>Can I get a refund?</summary><p>Yes, a full refund before production starts. After delivery, we resolve issues through your included revisions. See the Refund Policy for details.</p></details>
        <details><summary>Can I use the song publicly?</summary><p>Your song is for personal use: gifts, family events, weddings and personal social posts. Contact us for commercial use.</p></details>
      </div>
    </div>
  </section>

  <div class="fgn-sticky"><a href="#fgn-order" class="fgn-btn">{{ section.settings.button_label }}</a></div>
</div>

<script>
  (function(){
    var form=document.getElementById('fgn-form'); if(!form) return;
    var price=document.querySelector('[data-fgn-price]');
    form.querySelectorAll('input[name="id"]').forEach(function(r){
      r.addEventListener('change',function(){ if(price) price.textContent=r.dataset.price; });
    });
    form.addEventListener('submit',function(e){
      e.preventDefault();
      if(!form.reportValidity()) return;
      var btn=form.querySelector('[name="add"]'); btn.disabled=true;
      fetch('{{ routes.cart_add_url }}.js',{method:'POST',headers:{'Accept':'application/json'},body:new FormData(form)})
        .then(function(r){ if(!r.ok) throw r; window.location.href='{{ routes.cart_url }}'; })
        .catch(function(){ btn.disabled=false; alert('Something went wrong. Please try again.'); });
    });
  })();
</script>

{% schema %}
{
  "name": "FGN Custom Song page",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (leave empty on product template)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A gift they'll replay forever" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Turn your story into a song made just for them" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Their name, your memories, the feeling only you two share – turned into an original song with vocals. Perfect for Christmas, anniversaries, birthdays and every \"I love you\"." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "sample_title", "label": "Sample title", "default": "Listen to a sample song" },
    { "type": "url", "id": "sample_audio_url", "label": "Sample audio URL (MP3 from Settings > Files)" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Create my song" },
    { "type": "url", "id": "terms_url", "label": "Terms page" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Real customer review" },
        { "type": "text", "id": "author", "label": "Customer name / occasion" }
      ]
    }
  ],
  "presets": [{ "name": "FGN Custom Song page" }]
}
{% endschema %}
