      dots = Array.from(dotsContainer.querySelectorAll('.gt-dot'));
    }
    const arrows = document.querySelectorAll('.gt-arrow');

    // 是否为移动端布局 (实际功能仅在≤768px时需要导航，但为确保交互稳健，我们在点击和滚动时依旧判断)
    // 但因为桌面端导航是display:none且不可见，滚动无影响，不过添加resize监听明确启用/禁用轮询。
    let isMobileLayout = window.matchMedia('(max-width: 768px)').matches;

    // ---------- 辅助函数: 获取当前视口内最靠左(或居中最近的卡片索引) ----------
    // 原理：计算网格滚动容器中每个卡片左边缘相对于容器左侧滚动距离的绝对差值，取最小的索引
    // 保证滚动snap结束后高亮圆点精准
    function getCurrentCardIndex() {
      if (!grid || cards.length === 0) return 0;
      const scrollLeft = grid.scrollLeft;
      // 获取每个卡片相对 .gt-grid 容器左侧边缘的偏移量 (offsetLeft 包含了grid的padding)
      let minDiff = Infinity;
      let closestIndex = 0;
      for (let i = 0; i < cards.length; i++) {
        const card = cards[i];
        const cardOffsetLeft = card.offsetLeft;  // 相对滚动容器内容区左边缘
        // 差值: 滚动距离与卡片左边缘越接近代表当前聚焦卡片
        const diff = Math.abs(scrollLeft - cardOffsetLeft);
        if (diff < minDiff) {
          minDiff = diff;
          closestIndex = i;
        }
      }
      return closestIndex;
    }

    // 高亮当前激活的圆点
    function updateActiveDot(index) {
      if (!dots.length) return;
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });
    }

    // 滚动到指定索引的卡片（精准对齐，平滑移动）
    function scrollToCard(index, behavior = 'smooth') {
      if (!grid || index < 0 || index >= cards.length) return;
      const targetCard = cards[index];
      if (!targetCard) return;
      // 获取目标卡片的 offsetLeft (相对滚动容器内容区)
      const targetLeft = targetCard.offsetLeft;
      // 滚动容器滚动到目标位置
      grid.scrollTo({
        left: targetLeft,
        behavior: behavior
      });
      // 手动同步圆点（scroll事件也有防抖同步，但为保证立即反馈先同步一次）
      updateActiveDot(index);
    }

    // 刷新当前索引及圆点（基于滚动位置主动同步）
    function syncFromScroll() {
      if (!isMobileLayout) return;  // 桌面端没有圆点交互需求，但为了严谨无副作用
      const idx = getCurrentCardIndex();
      updateActiveDot(idx);
    }

    // 监听滚动事件（防抖 + 移动端实时同步）
    let scrollTimer = null;
    function onGridScroll() {
      if (!isMobileLayout) return;
      // 实时同步，避免高频下性能问题，使用requestAnimationFrame + 防抖最后精准一次
      if (scrollTimer) clearTimeout(scrollTimer);
      // 快速更新一次，保证箭头滑动时圆点及时响应
      const quickIdx = getCurrentCardIndex();
      updateActiveDot(quickIdx);
      // 最终滚动停止后再确认一次，避免惯性结束偏移
      scrollTimer = setTimeout(() => {
        const finalIdx = getCurrentCardIndex();
        updateActiveDot(finalIdx);
        scrollTimer = null;
      }, 80);
    }

    // ---------- 箭头导航逻辑 ----------
    function handleArrow(direction) {
      if (!isMobileLayout) return;
      const currentIdx = getCurrentCardIndex();
      let newIdx = currentIdx;
      if (direction === 'prev') {
        newIdx = Math.max(0, currentIdx - 1);
      } else if (direction === 'next') {
        newIdx = Math.min(totalCards - 1, currentIdx + 1);
      }
      if (newIdx !== currentIdx) {
        scrollToCard(newIdx, 'smooth');
        // 滚动后 syncFromScroll 会被 scroll 事件二次修正，但立即更新更跟手
        updateActiveDot(newIdx);
      }
    }

    // 绑定箭头事件
    arrows.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const dir = btn.getAttribute('data-gt-dir');
        if (dir === 'prev') handleArrow('prev');
        else if (dir === 'next') handleArrow('next');
      });
    });

    // 绑定圆点点击事件 (利用 data-gt-idx)
    if (dots.length) {
      dots.forEach(dot => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          const idxAttr = dot.getAttribute('data-gt-idx');
          if (idxAttr !== null) {
            const idx = parseInt(idxAttr, 10);
            if (!isNaN(idx) && idx >= 0 && idx < totalCards) {
              scrollToCard(idx, 'smooth');
            }
          }
        });
      });
    }

    // 监听网格滚动
    grid.addEventListener('scroll', onGridScroll);
    // 针对触摸结束或滚轮结束再次确保同步圆点
    grid.addEventListener('touchend', () => {
      if (!isMobileLayout) return;
      setTimeout(() => {
        const idx = getCurrentCardIndex();
        updateActiveDot(idx);
      }, 50);
    });
    grid.addEventListener('mouseup', () => {
      if (!isMobileLayout) return;
      setTimeout(() => {
        const idx = getCurrentCardIndex();
        updateActiveDot(idx);
      }, 30);
    });

    // ---------- 响应式布局变化：检测屏幕宽度变化重新判断移动端布局 / 重置圆点状态 ----------
    const mediaQuery = window.matchMedia('(max-width: 768px)');
    function handleLayoutChange(e) {
      const newIsMobile = e.matches;
      isMobileLayout = newIsMobile;
      if (!isMobileLayout) {
        // 桌面模式下，无需关注轮播逻辑，但避免残留高亮不影响体验，不做额外动作。
        // 移除一些移动端特有的滚动监听没必要停止但无副作用，保留即可。
      } else {
        // 切换成移动端时，重新计算一次当前滚动索引和高亮，确保刚刚切换到移动端时圆点正确
        setTimeout(() => {
          const idx = getCurrentCardIndex();
          updateActiveDot(idx);
          // 确保可滚动容器滚动位置相对于卡片0边界可能是padding导致偏移重新同步最左边界
          // 如果当前滚动位置由于桌面宽度改变导致异常，将其校准到最近卡片
          const currentIdxAfter = getCurrentCardIndex();
          if (currentIdxAfter !== idx) {
            scrollToCard(currentIdxAfter, 'auto');
          }
        }, 20);
      }
    }
    // 监听变化
    if (mediaQuery.addEventListener) {
      mediaQuery.addEventListener('change', handleLayoutChange);
    } else {
      // 兼容旧浏览器
      mediaQuery.addListener(handleLayoutChange);
    }

    // 初始化移动端状态：圆点与滚动位置同步，并确保首卡位置精确（防止因图片加载偏移导致初始滚动不对）
    function initMobileBehavior() {
      if (window.matchMedia('(max-width: 768px)').matches) {
        isMobileLayout = true;
        // 保证滚动区域的初始位置为0（由于页面加载时有可能滚动偏移因内容过度导致0位置非第一卡，无碍但圆点需同步）
        setTimeout(() => {
          const initialIdx = getCurrentCardIndex();
          updateActiveDot(initialIdx);
          // 如果有某些浏览器默认滚动偏移量>0且不是最完美卡片对齐，就主动对齐一下第一张卡，让视觉和圆点一致（加载时通常为0）
          if (grid.scrollLeft === 0) {
            // 确保圆点和第一张卡匹配
            if (initialIdx !== 0) {
              // 极少情况由于卡片偏移误判，强制校对
              scrollToCard(0, 'auto');
              updateActiveDot(0);
            }
          } else {
            // 若滚动位置偏离，将高亮与滚动位置同步即可，不强制跳转，避免打断用户预期
            const correctIdx = getCurrentCardIndex();
            updateActiveDot(correctIdx);
          }
        }, 60);
        // 另外监听图片完全加载后因为布局偏移导致偏移量改变重新同步圆点
        const images = document.querySelectorAll('.gt-img-wrap img');
        let loadedCount = 0;
        function reSyncAfterLoad() {
          loadedCount++;
          if (loadedCount === images.length) {
            // 所有图片加载完成后再次校准圆点，以防卡片尺寸变化影响滚动偏移
            setTimeout(() => {
              const idx = getCurrentCardIndex();
              updateActiveDot(idx);
              // 确保滚动边界对齐最近卡片 (优雅修正)
              if (grid.scrollLeft !== undefined) {
                const nearestIdx = getCurrentCardIndex();
                if (Math.abs(grid.scrollLeft - cards[nearestIdx]?.offsetLeft) > 5) {
                  scrollToCard(nearestIdx, 'auto');
                }
              }
            }, 40);
          }
        }
        if (images.length) {
          images.forEach(img => {
            if (img.complete) {
              reSyncAfterLoad();
            } else {
              img.addEventListener('load', reSyncAfterLoad, { once: true });
              img.addEventListener('error', reSyncAfterLoad, { once: true });
            }
          });
        } else {
          setTimeout(() => {
            const idx = getCurrentCardIndex();
            updateActiveDot(idx);
          }, 80);
        }
      } else {
        isMobileLayout = false;
      }
    }

    // 窗口Resize时重新校准圆点与滚动位置（因为网格宽度变化会影响卡片的偏移位置，圆点必须基于新滚动位置）
    let resizeTimer;
    window.addEventListener('resize', function() {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const nowMobile = window.matchMedia('(max-width: 768px)').matches;
        isMobileLayout = nowMobile;
        if (isMobileLayout) {
          // 先同步圆点
          const newIdx = getCurrentCardIndex();
          updateActiveDot(newIdx);
          // 轻微处理滚动位置容差，确保显示区域处于合理卡片（可让当前高亮卡片完整显示）
          const currentCard = cards[newIdx];
          if (currentCard) {
            const targetLeft = currentCard.offsetLeft;
            // 如果滚动位置和理想位置差距超过10px，则自动校准
            if (Math.abs(grid.scrollLeft - targetLeft) > 12) {
              grid.scrollTo({ left: targetLeft, behavior: 'smooth' });
            }
          }
        } else {
          // 桌面端无圆点高亮影响，无需额外动作
        }
      }, 100);
    });

    // 监听dom加载完成保证所有绑定
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileBehavior);
    } else {
      initMobileBehavior();
    }

    // 额外处理手动滑动停止后精准对齐（增强滚动体验）
    let isScrolling = false;
    grid.addEventListener('scrollend', () => {
      if (isMobileLayout) {
        const finalIdx = getCurrentCardIndex();
        updateActiveDot(finalIdx);
        // 再次确保滚动位置完美对齐卡片（使卡片完全位于可视区内）
        const targetCard = cards[finalIdx];
        if (targetCard) {
          const idealLeft = targetCard.offsetLeft;
          if (Math.abs(grid.scrollLeft - idealLeft) > 2) {
            grid.scrollTo({ left: idealLeft, behavior: 'smooth' });
          }
        }
      }
    });
    // 针对不支持 scrollend 的浏览器，用防抖兜底
    if (typeof grid.onscrollend === 'undefined') {
      let endTimer;
      grid.addEventListener('scroll', () => {
        if (endTimer) clearTimeout(endTimer);
        endTimer = setTimeout(() => {
          if (isMobileLayout) {
            const idx = getCurrentCardIndex();
            updateActiveDot(idx);
          }
        }, 120);
      });
    }
  })();
</script>
