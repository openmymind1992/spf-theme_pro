  }

  /* 🔥 呼吸灯绿点样式 */
  .nb-dot {
    position: relative;
    width: 8px;
    height: 8px;
    background-color: #00a859; /* 主绿点 */
    border-radius: 50%;
    box-shadow: 0 0 0 4px #d4f0e0; /* 浅绿色常驻光晕 */
    margin-right: 2px;
  }

  /* 呼吸灯扩散动画效果附加在伪元素上 */
  .nb-dot::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transform: translate(-1px, -1px);
    animation: nb-pulse 2s infinite;
  }

  @keyframes nb-pulse {
    0% { box-shadow: 0 0 0 0 rgba(0, 168, 89, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(0, 168, 89, 0); }
    100% { box-shadow: 0 0 0 0 rgba(0, 168, 89, 0); }
  }

  /* 🔥 文本颜色拆分 */
  .nb-count {
    color: #00a859; /* 数字绿色 */
    display: inline-block; /* 保证 transform 动画生效 */
  }

  .nb-text {
    color: #2b1b54; /* 文本深紫色 —— 未变动 */
  }

  /* 🔥 数字跳动动画 */
  .visitor-bounce {
    animation: visitorJump 0.35s ease;
  }

  @keyframes visitorJump {
    0% { transform: translateY(0); opacity: 1; }
    30% { transform: translateY(-6px); opacity: 0.7; }
    100% { transform: translateY(0); opacity: 1; }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  let max = 350; // 🔥 最大人数
  let min = 150; // 🔥 最小人数
  let delay = 4000; // 跳动间隔时间（单位：毫秒，4000 = 4秒）

  let counter = document.getElementById("nb_visitors_count");

  // 初始化：首次加载时，在 150 - 350 之间随机生成一个数字作为初始值
  let current = Math.floor(Math.random() * (max - min + 1)) + min;
  counter.textContent = current;

  function updateVisitors() {
    let currentCount = parseInt(counter.textContent);
    let randomJump = Math.floor(Math.random() * 15) - 7; // 每次随机 -7 到 +7 的波动

    let newCount = currentCount + randomJump;

    // 严格限制在 150 - 350 之间
    if (newCount > max) newCount = max;
    if (newCount < min) newCount = min;

    // 更新数字
    counter.textContent = newCount;

    // 重新触发跳动动画
    counter.classList.remove("visitor-bounce");
    void counter.offsetWidth; // 强制浏览器重绘（reflow），确保动画每次都生效
    counter.classList.add("visitor-bounce");
  }

  // 开始定时循环
  setInterval(updateVisitors, delay);
});
</script>
