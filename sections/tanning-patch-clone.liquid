  endif
%}

<section class="tp-clone">
  <style>
    .tp-clone {
      --tp-cream: #f7eedb;
      --tp-cream-2: #fbf7ee;
      --tp-ink: #24170d;
      --tp-soft: #5d4938;
      --tp-gold: #b78a45;
      --tp-gold-dark: #806331;
      --tp-green: #3b5b3e;
      --tp-card: #fffaf0;
      --tp-shadow: 0 18px 45px rgba(45, 31, 18, 0.13);
      background: var(--tp-cream);
      color: var(--tp-ink);
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
      overflow: hidden;
    }
    .tp-clone * { box-sizing: border-box; }
    .tp-clone img { display: block; max-width: 100%; height: auto; }
    .tp-wrap { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
    .tp-kicker {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 30px;
      padding: 6px 14px;
      border: 1px solid rgba(128, 99, 49, 0.35);
      border-radius: 999px;
      color: var(--tp-gold-dark);
      background: rgba(255, 255, 255, 0.45);
      font-size: 12px;
      letter-spacing: .08em;
      text-transform: uppercase;
      font-weight: 700;
    }
    .tp-title {
      margin: 14px 0 14px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(34px, 5vw, 68px);
      line-height: .98;
      letter-spacing: 0;
      color: var(--tp-ink);
    }
    .tp-subtitle {
      margin: 0;
      color: var(--tp-soft);
      font-size: clamp(15px, 1.6vw, 19px);
      line-height: 1.72;
    }
    .tp-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: 14px 24px;
      border-radius: 999px;
      background: linear-gradient(135deg, #1f160d, #5f4424 48%, #c69b53);
      color: #fff;
      text-decoration: none;
      text-transform: uppercase;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: .04em;
      box-shadow: 0 12px 30px rgba(70, 46, 20, .25);
    }
    .tp-btn:hover { color: #fff; transform: translateY(-1px); }
    .tp-section { padding: 58px 0; }
    .tp-section--light { background: var(--tp-cream-2); }
    .tp-section--dark { background: #23170f; color: #fff7e7; }
    .tp-section--dark .tp-title, .tp-section--dark h2, .tp-section--dark h3 { color: #fff7e7; }
    .tp-section--dark .tp-subtitle, .tp-section--dark p { color: #eadbc5; }

    .tp-live {
      padding: 10px 0;
      background: #15100b;
      color: #fff;
      font-size: 14px;
      text-align: center;
      font-weight: 700;
    }
    .tp-live span {
      display: inline-block;
      width: 9px;
      height: 9px;
      margin-right: 8px;
      border-radius: 50%;
      background: #49c16d;
      box-shadow: 0 0 0 6px rgba(73, 193, 109, .14);
    }

    .tp-hero {
      padding: 64px 0 50px;
      background:
        radial-gradient(circle at top left, rgba(255, 255, 255, .75), transparent 32%),
        linear-gradient(180deg, #fff8e8 0%, var(--tp-cream) 100%);
    }
    .tp-hero-grid {
      display: grid;
      grid-template-columns: 1.02fr .98fr;
      gap: 38px;
      align-items: center;
    }
    .tp-hero-copy .tp-subtitle { max-width: 630px; }
    .tp-hero-actions {
      display: flex;
      gap: 16px;
      align-items: center;
      flex-wrap: wrap;
      margin-top: 26px;
    }
    .tp-proof {
      display: flex;
      gap: 10px;
      align-items: center;
      color: var(--tp-soft);
      font-size: 14px;
      font-weight: 700;
    }
    .tp-stars { color: #c99a43; letter-spacing: .08em; }
    .tp-hero-image {
      border: 1px solid rgba(128, 99, 49, .25);
      border-radius: 18px;
      overflow: hidden;
      background: #fff;
      box-shadow: var(--tp-shadow);
    }

    .tp-testimonials {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 26px;
      margin-top: 30px;
    }
    .tp-testimonial {
      display: grid;
      grid-template-columns: 42% 1fr;
      gap: 22px;
      padding: 22px;
      border: 1px solid rgba(128, 99, 49, .28);
      border-radius: 12px;
      background: var(--tp-card);
      box-shadow: var(--tp-shadow);
    }
    .tp-testimonial img {
      width: 100%;
      height: 100%;
      min-height: 320px;
      object-fit: cover;
      border-radius: 8px;
    }
    .tp-quote-mark {
      font-family: Georgia, serif;
      font-size: 58px;
      line-height: .7;
      color: var(--tp-gold);
    }
    .tp-testimonial h3 {
      margin: 8px 0 12px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 25px;
      line-height: 1.1;
      color: var(--tp-ink);
    }
    .tp-testimonial p {
      margin: 0 0 12px;
      color: var(--tp-soft);
      font-size: 14px;
      line-height: 1.65;
    }
    .tp-author {
      color: var(--tp-ink);
      font-weight: 800;
    }
    .tp-verified {
      color: var(--tp-green);
      font-size: 13px;
      font-weight: 800;
    }

    .tp-centered {
      max-width: 850px;
      margin: 0 auto 30px;
      text-align: center;
    }
    .tp-card-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
    .tp-info-card {
      padding: 20px 22px 24px;
      border: 1.5px dashed var(--tp-gold);
      border-radius: 8px;
      background: rgba(255, 255, 255, .28);
    }
    .tp-info-card img {
      width: 100%;
      aspect-ratio: 1.3 / 1;
      object-fit: contain;
      margin: 0 auto 18px;
    }
    .tp-info-card h3 {
      margin: 0 0 10px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 18px;
      text-transform: uppercase;
      color: var(--tp-ink);
    }
    .tp-info-card p {
      margin: 0;
      color: var(--tp-soft);
      font-size: 14px;
      line-height: 1.72;
    }

    .tp-science-main {
      margin: 28px auto 30px;
      max-width: 880px;
      border-radius: 12px;
      overflow: hidden;
      background: #fff;
      box-shadow: var(--tp-shadow);
    }
    .tp-step-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
      margin-top: 24px;
    }
    .tp-step {
      padding: 18px;
      border: 1px solid rgba(128, 99, 49, .28);
      border-radius: 10px;
      background: #fffaf0;
    }
    .tp-step-num {
      color: var(--tp-gold-dark);
      font-family: Georgia, serif;
      font-size: 30px;
      font-weight: 700;
    }
    .tp-step img {
      width: 100%;
      aspect-ratio: 1.2 / 1;
      object-fit: contain;
      margin: 8px 0 12px;
    }
    .tp-step h3 {
      margin: 0 0 8px;
      font-size: 16px;
      color: var(--tp-ink);
    }
    .tp-step p {
      margin: 0;
      color: var(--tp-soft);
      font-size: 13px;
      line-height: 1.62;
    }
    .tp-note {
      margin: 28px auto 0;
      max-width: 860px;
      padding: 20px 24px;
      border-left: 4px solid var(--tp-gold);
      background: rgba(255, 255, 255, .5);
      color: var(--tp-soft);
      font-size: 14px;
      line-height: 1.7;
    }

    .tp-timeline-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
      margin-top: 30px;
    }
    .tp-time-card {
      overflow: hidden;
      border-radius: 14px;
      background: #fff;
      box-shadow: var(--tp-shadow);
    }
    .tp-time-card img {
      width: 100%;
      aspect-ratio: 1 / 1.18;
      object-fit: cover;
    }
    .tp-time-card div { padding: 18px; }
    .tp-time-card h3 {
      margin: 0 0 8px;
      color: var(--tp-ink);
      font-size: 18px;
    }
    .tp-time-card p {
      margin: 0;
      color: var(--tp-soft);
      font-size: 13.5px;
      line-height: 1.62;
    }

    .tp-tech {
      display: grid;
      grid-template-columns: .98fr 1.02fr;
      gap: 34px;
      align-items: center;
    }
    .tp-bullets {
      margin: 22px 0 0;
      padding: 0;
      list-style: none;
    }
    .tp-bullets li {
      position: relative;
      margin: 12px 0;
      padding-left: 22px;
      color: var(--tp-soft);
      line-height: 1.55;
    }
    .tp-bullets li::before {
      content: "";
      position: absolute;
      left: 0;
      top: .65em;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--tp-gold);
    }

    .tp-apply {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      margin-top: 30px;
    }
    .tp-apply-step {
      padding: 26px;
      border-radius: 12px;
      background: #fffaf0;
      box-shadow: var(--tp-shadow);
    }
    .tp-apply-step b {
      display: inline-flex;
      width: 42px;
      height: 42px;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--tp-ink);
      color: #fff;
      margin-bottom: 16px;
    }
    .tp-apply-step h3 {
      margin: 0 0 8px;
      font-size: 19px;
      color: var(--tp-ink);
    }
    .tp-apply-step p {
      margin: 0;
      color: var(--tp-soft);
      line-height: 1.65;
    }

    .tp-faq {
      max-width: 900px;
      margin: 28px auto 0;
    }
    .tp-faq details {
      border-top: 1px solid rgba(255, 247, 231, .22);
      padding: 18px 0;
    }
    .tp-faq details:last-child { border-bottom: 1px solid rgba(255, 247, 231, .22); }
    .tp-faq summary {
      cursor: pointer;
      color: #fff7e7;
      font-weight: 800;
      font-size: 18px;
    }
    .tp-faq p {
      margin: 12px 0 0;
      color: #eadbc5;
      line-height: 1.7;
    }

    .tp-offer {
      text-align: center;
      padding: 42px 0;
      background: linear-gradient(135deg, #2a1b10, #6b4d28);
      color: #fff;
    }
    .tp-offer h2 {
      margin: 0 0 10px;
      color: #fff;
      font-size: clamp(26px, 4vw, 42px);
    }
    .tp-timer {
      display: inline-flex;
      gap: 8px;
      margin: 12px 0 22px;
      color: #ffe5b4;
      font-weight: 900;
      letter-spacing: .04em;
    }
    .tp-sticky {
      position: sticky;
      bottom: 0;
      z-index: 20;
      display: flex;
      justify-content: center;
      padding: 10px 14px;
      background: rgba(35, 23, 15, .96);
      backdrop-filter: blur(8px);
    }
    .tp-sticky .tp-btn { min-height: 46px; width: min(420px, 100%); }

    @media (max-width: 980px) {
      .tp-hero-grid, .tp-tech { grid-template-columns: 1fr; }
      .tp-testimonials, .tp-card-grid { grid-template-columns: 1fr; }
      .tp-step-grid, .tp-timeline-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 640px) {
      .tp-wrap { width: min(100% - 24px, 1180px); }
      .tp-section { padding: 42px 0; }
      .tp-hero { padding: 42px 0 34px; }
      .tp-testimonial { grid-template-columns: 1fr; }
      .tp-testimonial img { min-height: 0; aspect-ratio: 1 / 1.05; }
      .tp-step-grid, .tp-timeline-grid, .tp-apply { grid-template-columns: 1fr; }
      .tp-title { font-size: 36px; }
    }
  </style>

