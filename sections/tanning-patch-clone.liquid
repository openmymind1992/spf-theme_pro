  }
</style>

<div class="alexbion-custom-liquid-wrapper">
  <div class="alexbion-compact-offer">
    <div class="alexbion-compact-inner">
      <div class="alexbion-compact-left">
        <span class="alexbion-compact-hot">80% OFF</span>
        <span class="alexbion-compact-timer">
          Ends in
          <strong>
            <span data-ab-hours>00</span>:<span data-ab-minutes>38</span>:<span data-ab-seconds>44</span>
          </strong>
        </span>
      </div>

      <a href="{{ cta_link }}" class="alexbion-compact-button">
        CLAIM OFFER &rarr;
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 倒计时逻辑：设置默认时间 (根据最新截图设为 38分44秒)
    const defaultTimeInSeconds = (38 * 60) + 44;
    const storageKey = 'alexbion_offer_timer_floating'; // 换了个缓存Key，方便重新计时

    let timeLeft = localStorage.getItem(storageKey);

    if (!timeLeft || isNaN(timeLeft) || timeLeft <= 0) {
      timeLeft = defaultTimeInSeconds;
    } else {
      timeLeft = parseInt(timeLeft, 10);
    }

    const hoursEl = document.querySelector('[data-ab-hours]');
    const minutesEl = document.querySelector('[data-ab-minutes]');
    const secondsEl = document.querySelector('[data-ab-seconds]');

    // 为 body 添加底部内边距，防止悬浮栏挡住网站底部的页脚信息
    document.body.style.paddingBottom = '100px';

    if (hoursEl && minutesEl && secondsEl) {
      const updateTimer = setInterval(() => {
        if (timeLeft <= 0) {
          clearInterval(updateTimer);
          localStorage.removeItem(storageKey);
          return;
        }

        timeLeft--;
        localStorage.setItem(storageKey, timeLeft);

        const h = Math.floor(timeLeft / 3600);
        const m = Math.floor((timeLeft % 3600) / 60);
        const s = timeLeft % 60;

        hoursEl.textContent = h.toString().padStart(2, '0');
        minutesEl.textContent = m.toString().padStart(2, '0');
        secondsEl.textContent = s.toString().padStart(2, '0');
      }, 1000);
    }
  });
</script>
  </div>
</div>


